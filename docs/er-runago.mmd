erDiagram
  USUARIOS ||--o{ EVENTOS : publica
  CATEGORIAS ||--o{ EVENTOS : clasifica
  LUGARES ||--o{ EVENTOS : aloja
  USUARIOS ||--o{ FAVORITOS : guarda
  EVENTOS ||--o{ FAVORITOS : "es guardado"
  USUARIOS ||--o{ INTERESES_USUARIO : tiene
  CATEGORIAS ||--o{ INTERESES_USUARIO : "es elegida"
  USUARIOS ||--o{ MEMBRESIAS : adquiere
  USUARIOS ||--o{ RESENAS : escribe
  EVENTOS ||--o{ RESENAS : recibe
  RESENAS ||--o{ FOTOS : incluye
  USUARIOS {
    int id PK
    string nombre
    string correo
    string contrasena_hash
    string rol
  }
  EVENTOS {
    int id PK
    int organizador_id FK
    int categoria_id FK
    int lugar_id FK
    string titulo
    string descripcion
    string etiquetas
    datetime fecha_inicio
    float latitud
    float longitud
    string imagen_url
  }
  LUGARES {
    int id PK
    string nombre
    string direccion
    float latitud
    float longitud
    string paradero_cercano
    string servicio_transporte
    int minutos_a_pie
  }
  CATEGORIAS {
    int id PK
    string nombre
  }
  FAVORITOS {
    int usuario_id PK
    int evento_id PK
    datetime guardado_en
    boolean en_plan
  }
  INTERESES_USUARIO {
    int usuario_id PK
    int categoria_id PK
  }
  MEMBRESIAS {
    int id PK
    int usuario_id FK
    string plan
    string estado
    date fecha_inicio
    date fecha_fin
  }
  RESENAS {
    int id PK
    int usuario_id FK
    int evento_id FK
    int calificacion
    string comentario
    datetime creada_en
  }
  FOTOS {
    int id PK
    int resena_id FK
    string url
  }
