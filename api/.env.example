# Puerto donde corre la API
PORT=3000

# Conexión de la app (Supabase, Transaction pooler, puerto 6543)
DATABASE_URL="postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa para migraciones (Supabase, Session pooler, puerto 5432)
DIRECT_URL="postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres"

# Orígenes permitidos para CORS (separados por coma). Opcional.
CORS_ORIGIN=http://localhost:8081

# Clave para firmar los tokens JWT (mínimo 32 caracteres). Genera una propia, por ejemplo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=pon_aqui_una_clave_larga_y_aleatoria_de_32_o_mas_caracteres

# Duración de cada sesión. Opcional, por defecto 7d
JWT_EXPIRES_IN=7d

# Usuario administrador que crea el seed (npm run db:seed)
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia_esta_contrasena

# Contraseña de los organizadores de prueba. Opcional: si no la pones, se genera una al azar
# y se muestra una sola vez en la consola.
ORGANIZADOR_PASSWORD=
